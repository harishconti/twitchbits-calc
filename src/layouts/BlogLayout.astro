---
import BaseLayout from './BaseLayout.astro';
import { buildBreadcrumbSchema } from '../lib/schema';
interface Props { title: string; description: string; pubDate: Date; slug: string; }
const { title, description, pubDate, slug } = Astro.props;
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog' }, { name: title, url: `/blog/${slug}` }];
const article = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description, datePublished: pubDate.toISOString(),
  url: `https://twitchbits-calc.com/blog/${slug}`,
};
---
<BaseLayout title={title} description={description} jsonLd={[article, buildBreadcrumbSchema(crumbs)]}>
  <div class="container">
    <article class="post">
      <nav class="crumbs"><a href="/">Home</a> <span>›</span> <a href="/blog">Blog</a> <span>›</span> <span>{title}</span></nav>
      <p class="eyebrow">Creator monetization guide</p>
      <h1>{title}</h1>
      <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time>
      <div class="prose"><slot /></div>
    </article>
  </div>
</BaseLayout>
<style>
  .post { max-width: 720px; margin: 0 auto; padding-block: var(--section-y-phone); }
  .eyebrow { color: var(--color-meta); font-size: var(--text-xs); font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: var(--spacing-3); }
  h1 { font-size: var(--text-3xl); font-weight: 800; margin-bottom: var(--spacing-4); }
  time { display: block; color: var(--color-muted); font-size: var(--text-sm); margin-bottom: var(--spacing-6); }
  .crumbs { font-size: var(--text-sm); color: var(--color-muted); margin-bottom: var(--spacing-5); }
  .crumbs a { color: var(--color-fg-2); font-weight: 600; transition: color var(--duration-fast) var(--ease-standard); }
  .crumbs a:hover { color: var(--color-accent); }
  .prose :global(p) { line-height: var(--leading-body); color: var(--color-fg); margin: var(--spacing-4) 0; }
  .prose :global(h2) { font-size: var(--text-xl); font-weight: 700; margin-top: var(--spacing-8); margin-bottom: var(--spacing-3); }
  .prose :global(h3) { font-size: var(--text-lg); font-weight: 700; margin-top: var(--spacing-6); margin-bottom: var(--spacing-3); }
  .prose :global(ul, ol) { padding-left: var(--spacing-6); color: var(--color-fg); }
  .prose :global(li) { margin-bottom: var(--spacing-2); }
  .prose :global(strong) { color: var(--color-fg); font-weight: 700; }
  .prose :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  @media (min-width: 640px) { .post { padding-block: var(--section-y-tablet); } }
  @media (min-width: 1024px) { .post { padding-block: var(--section-y-desktop); } }
</style>
