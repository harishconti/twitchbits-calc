---
interface Props { crumbs: { name: string; url: string }[]; }
const { crumbs } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((c, i) => (
      <li><a href={c.url}>{c.name}</a>{i < crumbs.length - 1 && <span class="sep">›</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .breadcrumbs { font-size: var(--text-sm); color: var(--color-muted); padding-top: var(--spacing-4); }
  .breadcrumbs ol { list-style: none; display: flex; gap: var(--spacing-2); flex-wrap: wrap; padding: 0; margin: 0; }
  .breadcrumbs a { color: var(--color-fg-2); font-weight: 600; transition: color var(--duration-fast) var(--ease-standard); }
  .breadcrumbs a:hover { color: var(--color-accent); }
  .sep { margin-left: var(--spacing-2); }
</style>
