---
import { getCollection } from 'astro:content';
interface Props { limit?: number; excludeSlug?: string; }
const { limit = 3, excludeSlug } = Astro.props;
const posts = (await getCollection('blog'))
  .filter(p => p.id !== excludeSlug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, limit);
if (posts.length === 0) return null;
---
<aside class="related-reads" aria-label="Related guides">
  <h3>Keep reading</h3>
  <ul>
    {posts.map(p => (
      <li>
        <a href={`/blog/${p.id}`}>
          <strong>{p.data.title}</strong>
          <span>{p.data.description}</span>
        </a>
      </li>
    ))}
  </ul>
</aside>
<style>
  .related-reads { display: flex; flex-direction: column; gap: var(--spacing-3); padding: var(--spacing-4); border: 1px solid var(--color-border-soft); border-radius: var(--radius-md); background: var(--color-surface-warm); }
  .related-reads h3 { font-size: var(--text-sm); font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-muted); }
  .related-reads ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--spacing-2); }
  .related-reads a { display: flex; flex-direction: column; gap: var(--spacing-1); color: var(--color-fg); text-decoration: none; padding: var(--spacing-3); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg); transition: border-color var(--duration-fast) var(--ease-standard); }
  .related-reads a:hover { border-color: var(--color-accent); }
  .related-reads strong { font-size: var(--text-sm); font-weight: 700; }
  .related-reads span { font-size: var(--text-xs); color: var(--color-muted); line-height: 1.4; }
</style>
