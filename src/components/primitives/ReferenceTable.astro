---
interface Props { rows: { bits: number; usd: number }[]; currency?: string; unitLabel?: string; }
const { rows, currency = 'USD', unitLabel = 'Bits' } = Astro.props;
---
<table class="ref-table">
  <thead><tr><th>{unitLabel}</th><th>{currency}</th></tr></thead>
  <tbody>
    {rows.map(r => (
      <tr><td class="mono">{r.bits.toLocaleString('en-US')}</td><td class="mono">{r.usd.toLocaleString('en-US',{style:'currency',currency})}</td></tr>
    ))}
  </tbody>
</table>
<style>
  .ref-table { width: 100%; border-collapse: collapse; margin-top: var(--spacing-5); }
  .ref-table th, .ref-table td { padding: var(--spacing-3) var(--spacing-4); text-align: right; border-bottom: 1px solid var(--color-border-soft); }
  .ref-table thead th { color: var(--color-muted); font-weight: 700; font-size: var(--text-sm); }
  .ref-table tbody td { font-size: var(--text-base); color: var(--color-fg); }
  .ref-table tbody tr:nth-child(even) { background: var(--color-surface-warm); }
  .ref-table tbody tr:last-child td { border-bottom: 0; }
</style>
