---
import { SITE } from '../../lib/site';
---
<footer class="footer">
  <div class="container footer-inner">
    <nav aria-label="Footer">
      <a href="/affiliate-disclosure">Affiliate Disclosure</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
    </nav>
    <p>© {new Date().getFullYear()} {SITE.name}. Calculators are estimates, not financial advice.</p>
  </div>
</footer>
<style>
  .footer { border-top: 1px solid var(--color-border); background: var(--color-bg); color: var(--color-muted); font-size: var(--text-sm); }
  .footer-inner { display: flex; flex-direction: column; gap: var(--spacing-3); padding-block: var(--spacing-6); }
  .footer nav { display: flex; gap: var(--spacing-5); }
  .footer a { color: var(--color-fg-2); font-weight: 600; transition: color var(--duration-fast) var(--ease-standard); }
  .footer a:hover { color: var(--color-accent); }
  @media (min-width: 640px) { .footer-inner { flex-direction: row; align-items: center; justify-content: space-between; } }
</style>
