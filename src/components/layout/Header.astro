---
import { SITE, TOOLS } from '../../lib/site';
import ThemeToggle from '../primitives/ThemeToggle.astro';
---
<header class="header">
  <div class="container header-inner">
    <a class="logo" href="/">{SITE.name}</a>
    <nav aria-label="Primary" class="nav">
      <details class="tools-menu">
        <summary>Tools</summary>
        <ul class="tools-dropdown">
          {TOOLS.map(t => <li><a href={`/${t.slug}`}>{t.name}</a></li>)}
        </ul>
      </details>
      <a href="/blog">Blog</a>
      <a href="/affiliate-disclosure">Disclosure</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
<style>
  .header { border-bottom: 1px solid var(--color-border); background: var(--color-bg); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 64px; }
  .logo { font-weight: 800; font-size: var(--text-lg); color: var(--color-fg); font-family: var(--font-display); letter-spacing: var(--tracking-display); }
  .nav { display: flex; align-items: center; gap: var(--spacing-5); }
  .nav > a { font-size: var(--text-sm); font-weight: 600; color: var(--color-fg-2); transition: color var(--duration-fast) var(--ease-standard); }
  .nav > a:hover { color: var(--color-accent); }
  .tools-menu summary { cursor: pointer; list-style: none; font-size: var(--text-sm); font-weight: 600; color: var(--color-fg-2); }
  .tools-dropdown { position: absolute; top: 100%; right: 0; list-style: none; margin: var(--spacing-2) 0 0; padding: var(--spacing-3); min-width: 220px; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--shadow-raised); }
  .tools-dropdown a { display: block; padding: var(--spacing-2) var(--spacing-3); font-size: var(--text-sm); color: var(--color-fg); border-radius: var(--radius-sm); transition: background-color var(--duration-fast) var(--ease-standard); }
  .tools-dropdown a:hover { background: var(--color-surface-warm); color: var(--color-accent); }
  .tools-menu { position: relative; }
  @media (max-width: 639px) { .nav { gap: var(--spacing-4); } .tools-dropdown { right: -48px; } }
</style>
