---
import LinearConverter from './LinearConverter.astro';
import { bitsToUsd, usdToBits, bulkTable } from '../../lib/calculators/bits';
import { BULK_TABLE, VIEWER_PACKS, BITS_RATE_USD } from '../../data/bitsConfig';
const defaultPerBit = VIEWER_PACKS[0].perBitUsd;
const twitchMarkup = ((defaultPerBit - BITS_RATE_USD) / BITS_RATE_USD) * 100;
---
<LinearConverter config={{
  tool: 'bits', unitName: 'Bits', paramKey: 'bits',
  toUsd: bitsToUsd, fromUsd: usdToBits,
  bulkRows: BULK_TABLE, toBulkRows: (rows) => bulkTable(rows),
  viewerContext: { perUnitCostUsd: defaultPerBit, label: 'Viewer pays' },
}} />

<div class="bits-edu">
  <h3>How Twitch makes money on Bits</h3>
  <p>
    Streamers keep <strong>100% of the payout</strong> ($0.01 per Bit). Twitch earns the spread when viewers buy Bits in packs — roughly <strong>{twitchMarkup.toFixed(0)}% markup</strong> over the streamer rate on smaller packs.
  </p>
  <div class="bits-split">
    <div class="split-card">
      <span class="split-label">Streamer take-home</span>
      <strong class="mono">$0.0100</strong>
      <span class="split-note">per Bit</span>
    </div>
    <div class="split-card accent">
      <span class="split-label">Twitch + payment spread</span>
      <strong class="mono">~${(defaultPerBit - BITS_RATE_USD).toFixed(4)}</strong>
      <span class="split-note">per Bit</span>
    </div>
    <div class="split-card">
      <span class="split-label">Viewer pays (avg pack)</span>
      <strong class="mono">~${defaultPerBit.toFixed(4)}</strong>
      <span class="split-note">per Bit</span>
    </div>
  </div>
</div>

<style>
  .bits-edu { display: flex; flex-direction: column; gap: var(--spacing-4); padding-top: var(--spacing-6); border-top: 1px solid var(--color-border-soft); }
  .bits-edu h3 { font-size: var(--text-xl); font-weight: 700; }
  .bits-edu p { color: var(--color-muted); line-height: var(--leading-body); max-width: 680px; }
  .bits-split { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--spacing-3); }
  .split-card { display: flex; flex-direction: column; gap: var(--spacing-1); padding: var(--spacing-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg); }
  .split-card.accent { border-color: var(--color-accent); background: var(--color-surface-warm); }
  .split-label { font-size: var(--text-xs); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted); }
  .split-card strong { font-family: var(--font-mono); font-size: var(--text-xl); color: var(--color-fg); }
  .split-card.accent strong { color: var(--color-accent); }
  .split-note { font-size: var(--text-sm); color: var(--color-muted); }
  @media (max-width: 560px) { .bits-split { grid-template-columns: 1fr; } }
</style>
