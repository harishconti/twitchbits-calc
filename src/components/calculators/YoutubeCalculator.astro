---
import RangeSlider from '../primitives/RangeSlider.astro';
import { RPM_BY_NICHE, RPM_BY_FORMAT, RPM_BY_COUNTRY, DEFAULT_RPM } from '../../data/youtubeConfig';
---
<form class="yt-calc" data-tool="youtube">
  <div class="format-toggle" role="radiogroup" aria-label="Video format">
    {Object.entries(RPM_BY_FORMAT).map(([key, fmt], i) => (
      <label class={i === 0 ? 'fmt active' : 'fmt'}>
        <input type="radio" name="format" value={key} checked={i === 0} />
        <span>{fmt.label}</span>
      </label>
    ))}
  </div>

  <div class="field-group">
    <RangeSlider id="views" label="Monthly views" min={0} max={10_000_000} step={1000} value={50000} />
    <label class="field">
      Niche
      <select data-niche>
        {RPM_BY_NICHE.map((n, i) => <option value={i} selected={i === 1}>{n.label}</option>)}
      </select>
    </label>
  </div>

  <div class="field-group">
    <label class="field">
      Audience country
      <select data-country>
        {Object.entries(RPM_BY_COUNTRY).map(([key, c]) => <option value={key}>{c.label}</option>)}
      </select>
    </label>
    <RangeSlider id="custom-rpm" label="Custom RPM ($)" min={0} max={20} step={0.1} value={0} suffix="/1k views" />
  </div>

  <div class="result" data-result aria-live="polite">$0 – $0 / month</div>
  <p class="result-note" data-result-note>Estimate based on typical RPM range for the selected niche and format.</p>

  <div class="what-if" data-what-if>
    <strong>What if your RPM changed?</strong>
    <div class="what-if-grid" data-what-if-grid></div>
  </div>
</form>
<script>
  import { rangeFromRpm, earningsFromViews, adjustedRpm } from '../../lib/calculators/youtube';
  import { RPM_BY_NICHE, RPM_BY_FORMAT, RPM_BY_COUNTRY, DEFAULT_RPM } from '../../data/youtubeConfig';
  import { formatCurrency } from '../../lib/format';

  const form = document.querySelector('[data-tool="youtube"]') as HTMLFormElement;
  const formatInputs = form.querySelectorAll<HTMLInputElement>('input[name="format"]');
  const viewsSlider = form.querySelector('[data-range-slider="views"]') as HTMLElement;
  const rpmSlider = form.querySelector('[data-range-slider="custom-rpm"]') as HTMLElement;
  const nicheSelect = form.querySelector('[data-niche]') as HTMLSelectElement;
  const countrySelect = form.querySelector('[data-country]') as HTMLSelectElement;
  const result = form.querySelector('[data-result]') as HTMLElement;
  const note = form.querySelector('[data-result-note]') as HTMLElement;
  const whatIfGrid = form.querySelector('[data-what-if-grid]') as HTMLElement;

  const fmtValue = () => Array.from(formatInputs).find(i => i.checked)?.value ?? 'long';
  const viewsValue = () => Number(viewsSlider.dataset.value ?? 0);
  const customRpm = () => Number(rpmSlider.dataset.value ?? 0);

  const getBounds = () => {
    const fmt = fmtValue() as keyof typeof RPM_BY_FORMAT;
    const country = (countrySelect.value ?? 'us') as keyof typeof RPM_BY_COUNTRY;
    const nicheIndex = Number(nicheSelect.value ?? 0);
    const niche = RPM_BY_NICHE[nicheIndex] ?? DEFAULT_RPM;
    const fmtFactor = RPM_BY_FORMAT[fmt].factor;
    const countryFactor = RPM_BY_COUNTRY[country].factor;
    return adjustedRpm(niche.low, niche.high, fmtFactor, countryFactor);
  };

  const render = () => {
    const views = viewsValue();
    const custom = customRpm();
    let low: number, high: number;
    if (custom > 0) {
      low = high = earningsFromViews(views, custom);
      note.textContent = `Using your custom RPM of ${formatCurrency(custom, 'USD')} per 1,000 views.`;
    } else {
      const bounds = getBounds();
      ({ low, high } = rangeFromRpm(views, low = bounds.low, high = bounds.high));
      const fmtLabel = RPM_BY_FORMAT[fmtValue() as keyof typeof RPM_BY_FORMAT].label;
      const countryLabel = RPM_BY_COUNTRY[(countrySelect.value ?? 'us') as keyof typeof RPM_BY_COUNTRY].label;
      note.textContent = `Estimate for ${fmtLabel}, audience mainly in ${countryLabel}, based on typical ${RPM_BY_NICHE[Number(nicheSelect.value ?? 0)]?.label ?? ''} RPM range.`;
    }
    result.textContent = `${formatCurrency(low, 'USD')} – ${formatCurrency(high, 'USD')} / month`;

    // What-if scenarios
    const scenarios = [1, 3, 5, 10];
    whatIfGrid.innerHTML = scenarios.map(rpm => {
      const e = earningsFromViews(views, rpm);
      return `<div class="scenario">
        <span class="scenario-rpm">${formatCurrency(rpm, 'USD')} RPM</span>
        <span class="scenario-earn">${formatCurrency(e, 'USD')}/mo</span>
      </div>`;
    }).join('');
  };

  formatInputs.forEach(i => i.addEventListener('change', render));
  nicheSelect.addEventListener('change', render);
  countrySelect.addEventListener('change', render);
  viewsSlider.addEventListener('input', render);
  rpmSlider.addEventListener('input', render);

  render();
</script>
<style>
  .yt-calc { display: flex; flex-direction: column; gap: var(--spacing-6); }
  .format-toggle { display: inline-flex; gap: var(--spacing-1); padding: var(--spacing-1); background: var(--color-surface-warm); border: 1px solid var(--color-border-soft); border-radius: var(--radius-md); width: fit-content; }
  .fmt { display: inline-flex; align-items: center; cursor: pointer; padding: var(--spacing-2) var(--spacing-4); border-radius: var(--radius-sm); font: 700 var(--text-sm)/1 var(--font-body); color: var(--color-muted); transition: background-color var(--duration-fast) var(--ease-standard), color var(--duration-fast) var(--ease-standard); }
  .fmt input { position: absolute; opacity: 0; pointer-events: none; }
  .fmt.active, .fmt:has(input:checked) { background: var(--color-accent); color: var(--color-accent-on); }
  .field-group { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-5); align-items: start; }
  .field { display: grid; gap: var(--spacing-2); color: var(--color-fg-2); font-size: var(--text-sm); font-weight: 700; }
  input, select { width: 100%; min-height: 46px; padding: 0 var(--spacing-3); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg); color: var(--color-fg); font: inherit; transition: border-color var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard); }
  input:focus, select:focus { outline: none; border-color: var(--color-accent); box-shadow: var(--shadow-focus-ring); }
  .result { font-family: var(--font-mono); font-size: clamp(26px, 4vw, 44px); font-weight: 700; color: var(--color-accent); line-height: var(--leading-tight); white-space: nowrap; }
  .result-note { color: var(--color-muted); font-size: var(--text-sm); }
  .what-if { display: flex; flex-direction: column; gap: var(--spacing-3); padding: var(--spacing-4); border: 1px solid var(--color-border-soft); border-radius: var(--radius-md); background: var(--color-surface-warm); }
  .what-if strong { font-size: var(--text-sm); color: var(--color-fg); }
  .what-if-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--spacing-3); }
  .scenario { display: flex; flex-direction: column; gap: var(--spacing-1); padding: var(--spacing-3); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-bg); }
  .scenario-rpm { font-size: var(--text-xs); font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted); }
  .scenario-earn { font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 700; color: var(--color-fg); }
  @media (max-width: 560px) { .field-group, .what-if-grid { grid-template-columns: 1fr; } }
</style>
