---
import Tabs from '../primitives/Tabs.astro';
import NumberInput from '../primitives/NumberInput.astro';
import ResultDisplay from '../primitives/ResultDisplay.astro';
import CopyButton from '../primitives/CopyButton.astro';
import ShareButton from '../primitives/ShareButton.astro';
import ReferenceTable from '../primitives/ReferenceTable.astro';
import Tooltip from '../primitives/Tooltip.astro';
import { formatCurrency } from '../../lib/format';

export interface ConverterConfig {
  tool: 'bits' | 'tiktok';
  unitName: string;
  paramKey: string;
  toUsd: (n: number) => number;
  fromUsd: (u: number) => number;
  bulkRows: number[];
  toBulkRows: (rows: number[]) => { bits: number; usd: number }[];
  currency?: string;
  region?: string;
  defaultAmount?: number;
  viewerContext?: { perUnitCostUsd: number; label: string };
}
const { config } = Astro.props as { config: ConverterConfig };
const rows = config.toBulkRows(config.bulkRows);
---
<div class="calculator" data-tool={config.tool}>
  <Tabs id="tabs" tabs={[config.unitName, 'USD']} />
  <NumberInput id="amount" label={config.unitName} autofocus value={config.defaultAmount ?? ''} />
  <ResultDisplay id="result" />
  <div class="breakdown">
    <div class="breakdown-row">
      <span>Streamer gets</span>
      <strong class="mono">{formatCurrency(config.toUsd(config.defaultAmount ?? 0), config.currency ?? 'USD')}</strong>
      <span class="note">100%</span>
    </div>
    {config.viewerContext && (
      <div class="breakdown-row">
        <span>{config.viewerContext.label}</span>
        <strong class="mono">~${config.viewerContext.perUnitCostUsd.toFixed(4)}</strong>
        <span class="note">per unit <Tooltip id="vc" text="What viewers pay per unit, based on pack pricing." /></span>
      </div>
    )}
  </div>
  <div class="actions">
    <CopyButton id="copy" />
    <ShareButton id="share" />
  </div>
  <ReferenceTable rows={rows} currency={config.currency ?? 'USD'} unitLabel={config.unitName} />
</div>
<style>
  .calculator { display: flex; flex-direction: column; gap: var(--spacing-4); }
  .breakdown { display: flex; flex-direction: column; gap: var(--spacing-2); }
  .breakdown-row { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: var(--spacing-3); font-size: var(--text-sm); color: var(--color-muted); }
  .breakdown-row strong { color: var(--color-fg); font-size: var(--text-base); }
  .note { color: var(--color-muted); }
  .actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-3); margin-top: var(--spacing-2); }
</style>
<!--
  The pure functions can't survive JSON.stringify (they'd become strings), so we
  serialize only metadata and re-import the real functions in the island by `tool`.
-->
<script id="__lc_config__" type="application/json" is:inline set:html={JSON.stringify({
  tool: config.tool, unitName: config.unitName, paramKey: config.paramKey,
  currency: config.currency ?? 'USD', region: config.region, defaultAmount: config.defaultAmount,
})} />
<script>
  import { initLinearConverter } from '../../scripts/calculator-behavior';
  import { bitsToUsd, usdToBits } from '../../lib/calculators/bits';
  import { coinsToUsd, usdToCoins } from '../../lib/calculators/tiktok';
  const root = document.querySelector('[data-tool]');
  const meta = JSON.parse(document.getElementById('__lc_config__')?.textContent ?? '{}');
  const FNS = {
    bits: { toUsd: (n: number) => bitsToUsd(n, meta.region), fromUsd: (u: number) => usdToBits(u, meta.region) },
    tiktok: { toUsd: coinsToUsd, fromUsd: usdToCoins },
  };
  const fns = FNS[meta.tool];
  if (!fns) throw new Error(`LinearConverter: no functions registered for tool "${meta.tool}"`);
  initLinearConverter(root, { ...meta, ...fns });
</script>
