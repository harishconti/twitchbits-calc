---
import ToolLayout from '../layouts/ToolLayout.astro';
import LinearConverter from '../components/calculators/LinearConverter.astro';
import { bitsToUsd, usdToBits, bulkTable } from '../lib/calculators/bits';
import { BULK_TABLE, VIEWER_PACKS, REGIONS } from '../data/bitsConfig';
import { bitsFaqs } from '../data/faqs';
const region = REGIONS.mx;
---
<ToolLayout
  title="Twitch Bits to MXN Calculator"
  description={`Convert Twitch Bits to Mexican Pesos (MXN). See streamer payout and viewer cost at the ${region.rate}:1 USD rate.`}
  slug="twitch-bits-to-mxn"
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Twitch Tools', url: '/twitch-bits-to-mxn' }]}
  faqs={bitsFaqs('mx')}
>
  <LinearConverter config={{
    tool: 'bits', unitName: 'Bits', paramKey: 'bits', region: 'mx', currency: 'MXN',
    toUsd: (n) => bitsToUsd(n, 'mx'), fromUsd: (u) => usdToBits(u, 'mx'),
    bulkRows: BULK_TABLE, toBulkRows: (rows) => bulkTable(rows, 'mx'),
    viewerContext: { perUnitCostUsd: VIEWER_PACKS[0].perBitUsd, label: 'Viewer pays' },
  }} />
</ToolLayout>
