---
import ToolLayout from '../layouts/ToolLayout.astro';
import LinearConverter from '../components/calculators/LinearConverter.astro';
import { bitsToUsd, usdToBits, bulkTable } from '../lib/calculators/bits';
import { BULK_TABLE, VIEWER_PACKS, REGIONS } from '../data/bitsConfig';
import { bitsFaqs } from '../data/faqs';
const region = REGIONS.eu;
---
<ToolLayout
  title="Twitch Bits to EUR Calculator"
  description={`Convert Twitch Bits to Euros (EUR). See streamer payout and viewer cost at the ${region.rate}:1 USD rate.`}
  slug="twitch-bits-to-eur"
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Twitch Tools', url: '/twitch-bits-to-eur' }]}
  faqs={bitsFaqs('eu')}
>
  <LinearConverter config={{
    tool: 'bits', unitName: 'Bits', paramKey: 'bits', region: 'eu', currency: 'EUR',
    toUsd: (n) => bitsToUsd(n, 'eu'), fromUsd: (u) => usdToBits(u, 'eu'),
    bulkRows: BULK_TABLE, toBulkRows: (rows) => bulkTable(rows, 'eu'),
    viewerContext: { perUnitCostUsd: VIEWER_PACKS[0].perBitUsd, label: 'Viewer pays' },
  }} />
</ToolLayout>