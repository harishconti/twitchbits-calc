---
import ToolLayout from '../layouts/ToolLayout.astro';
import LinearConverter from '../components/calculators/LinearConverter.astro';
import { bitsToUsd, usdToBits, bulkTable } from '../lib/calculators/bits';
import { BULK_TABLE, VIEWER_PACKS, REGIONS } from '../data/bitsConfig';
import { bitsFaqs } from '../data/faqs';
const region = REGIONS.au;
---
<ToolLayout
  title="Twitch Bits to AUD Calculator"
  description={`Convert Twitch Bits to Australian Dollars (AUD). See streamer payout and viewer cost at the ${region.rate}:1 USD rate.`}
  slug="twitch-bits-to-aud"
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Twitch Tools', url: '/twitch-bits-to-aud' }]}
  faqs={bitsFaqs('au')}
>
  <LinearConverter config={{
    tool: 'bits', unitName: 'Bits', paramKey: 'bits', region: 'au', currency: 'AUD',
    toUsd: (n) => bitsToUsd(n, 'au'), fromUsd: (u) => usdToBits(u, 'au'),
    bulkRows: BULK_TABLE, toBulkRows: (rows) => bulkTable(rows, 'au'),
    viewerContext: { perUnitCostUsd: VIEWER_PACKS[0].perBitUsd, label: 'Viewer pays' },
  }} />
</ToolLayout>