---
import ToolLayout from '../layouts/ToolLayout.astro';
import LinearConverter from '../components/calculators/LinearConverter.astro';
import { bitsToUsd, usdToBits, bulkTable } from '../lib/calculators/bits';
import { BULK_TABLE, VIEWER_PACKS, REGIONS } from '../data/bitsConfig';
import { bitsFaqs } from '../data/faqs';
const region = REGIONS.in;
---
<ToolLayout
  title="Twitch Bits to INR Calculator"
  description={`Convert Twitch Bits to Indian Rupees (INR). See streamer payout and viewer cost at the ${region.rate}:1 USD rate.`}
  slug="twitch-bits-to-inr"
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Twitch Tools', url: '/twitch-bits-to-inr' }]}
  faqs={bitsFaqs('in')}
>
  <LinearConverter config={{
    tool: 'bits', unitName: 'Bits', paramKey: 'bits', region: 'in', currency: 'INR',
    toUsd: (n) => bitsToUsd(n, 'in'), fromUsd: (u) => usdToBits(u, 'in'),
    bulkRows: BULK_TABLE, toBulkRows: (rows) => bulkTable(rows, 'in'),
    viewerContext: { perUnitCostUsd: VIEWER_PACKS[0].perBitUsd, label: 'Viewer pays' },
  }} />
</ToolLayout>
