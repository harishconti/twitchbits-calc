---
import ToolLayout from '../layouts/ToolLayout.astro';
import LinearConverter from '../components/calculators/LinearConverter.astro';
import { bitsToUsd, usdToBits, bulkTable } from '../lib/calculators/bits';
import { BULK_TABLE, VIEWER_PACKS, REGIONS } from '../data/bitsConfig';
import { bitsFaqs } from '../data/faqs';
const region = REGIONS.jp;
---
<ToolLayout
  title="Twitch Bits to JPY Calculator"
  description={`Convert Twitch Bits to Japanese Yen (JPY). See streamer payout and viewer cost at the ${region.rate}:1 USD rate.`}
  slug="twitch-bits-to-jpy"
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Twitch Tools', url: '/twitch-bits-to-jpy' }]}
  faqs={bitsFaqs('jp')}
>
  <LinearConverter config={{
    tool: 'bits', unitName: 'Bits', paramKey: 'bits', region: 'jp', currency: 'JPY',
    toUsd: (n) => bitsToUsd(n, 'jp'), fromUsd: (u) => usdToBits(u, 'jp'),
    bulkRows: BULK_TABLE, toBulkRows: (rows) => bulkTable(rows, 'jp'),
    viewerContext: { perUnitCostUsd: VIEWER_PACKS[0].perBitUsd, label: 'Viewer pays' },
  }} />
</ToolLayout>
